{
  "name": "sdk-apple-eventkit",
  "sourceRoot": "packages/sdks/apple/eventkit/src",
  "projectType": "library",
  "tags": ["layer:island", "layer:sdk", "platform:darwin"],
  "targets": {
    "helper": {
      "command": "sh packages/sdks/apple/eventkit/src/helper/build.sh packages/sdks/apple/eventkit/dist/eventkit-helper",
      "cache": true,
      "inputs": ["{projectRoot}/src/helper/*"],
      "outputs": ["{projectRoot}/dist/eventkit-helper"]
    },
    "build": {
      "dependsOn": ["...", "helper"]
    },
    "test-prompt": {
      "command": "node --test --no-warnings --test-timeout=600000 --test-concurrency=1 \"src/**/*.prompt.spec.ts\"",
      "options": { "cwd": "{projectRoot}" },
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
