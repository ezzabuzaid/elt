{
  "name": "sdk-apple-eventkit",
  "sourceRoot": "packages/sdks/apple/eventkit/src",
  "projectType": "library",
  "tags": ["layer:island", "layer:sdk"],
  "targets": {
    "format": {},
    "helper": {
      "command": "sh packages/sdks/apple/eventkit/src/helper/build.sh packages/sdks/apple/eventkit/dist/eventkit-helper",
      "cache": true,
      "inputs": ["{projectRoot}/src/helper/*"],
      "outputs": ["{projectRoot}/dist/eventkit-helper"]
    },
    "build": {
      "dependsOn": ["...", "helper"]
    },
    "test": {
      "dependsOn": ["build"],
      "command": "node --test \"packages/sdks/apple/eventkit/dist/*.test.js\""
    }
  }
}
