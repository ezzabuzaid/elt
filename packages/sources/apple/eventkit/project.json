{
  "name": "source-apple-eventkit",
  "sourceRoot": "packages/sources/apple/eventkit/src",
  "projectType": "library",
  "tags": ["layer:island"],
  "targets": {
    "format": {},
    "eventkit": {
      "command": "sh packages/sources/apple/eventkit/src/eventkit/build.sh packages/sources/apple/eventkit/dist/eventkit",
      "cache": true,
      "inputs": ["{projectRoot}/src/eventkit/*"],
      "outputs": ["{projectRoot}/dist/eventkit"]
    },
    "build": {
      "dependsOn": ["...", "eventkit"]
    },
    "test": {
      "dependsOn": ["build"],
      "command": "node --test \"packages/sources/apple/eventkit/dist/*.test.js\""
    }
  }
}
