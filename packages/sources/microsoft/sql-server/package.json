{
  "name": "@eltjs/source-microsoft-sql-server",
  "version": "0.3.2",
  "description": "An elt source for one SQL Server database: each user table that the login can read becomes a stream.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ezzabuzaid/elt",
    "directory": "packages/sources/microsoft/sql-server"
  },
  "bugs": {
    "url": "https://github.com/ezzabuzaid/elt/issues"
  },
  "homepage": "https://github.com/ezzabuzaid/elt/tree/main/packages/sources/microsoft/sql-server#readme",
  "keywords": [
    "elt",
    "sql-server",
    "mssql",
    "azure-sql",
    "source",
    "change-tracking"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./sql-server-copies": {
      "types": "./dist/sql-server-copies.d.ts",
      "default": "./dist/sql-server-copies.js"
    },
    "./sql-server-source": {
      "types": "./dist/sql-server-source.d.ts",
      "default": "./dist/sql-server-source.js"
    }
  },
  "files": [
    "dist",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@eltjs/elt": "^0.3.2",
    "@eltjs/sdk-microsoft-sql-server": "^0.3.2",
    "@zukhruf/async": "^0.8.10",
    "@zukhruf/snapshot-differential": "^0.8.10"
  },
  "devDependencies": {
    "@sinonjs/fake-timers": "15.4.0",
    "@types/mssql": "^12.3.0",
    "@eltjs/elt-postgresql": "0.0.1",
    "@zukhruf/testing": "^0.8.10",
    "mssql": "^12.7.4",
    "postgres": "^3.4.9"
  }
}
