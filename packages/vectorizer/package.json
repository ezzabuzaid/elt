{
  "name": "@eltjs/vectorizer",
  "version": "0.12.0",
  "description": "One declaration that keeps the passage contract of @zukhruf/retrieval in step with an elt pipeline: passages with metadata, their vectors with the model identity, and a keyword index.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ezzabuzaid/elt",
    "directory": "packages/vectorizer"
  },
  "bugs": {
    "url": "https://github.com/ezzabuzaid/elt/issues"
  },
  "homepage": "https://github.com/ezzabuzaid/elt/tree/main/packages/vectorizer#readme",
  "keywords": [
    "elt",
    "rag",
    "vectorizer",
    "embedding",
    "chunking",
    "bm25",
    "fts5",
    "sqlite"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "default": "./dist/sqlite.js"
    }
  },
  "files": [
    "dist",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@eltjs/chunking": "^0.12.0",
    "@eltjs/elt": "^0.12.0",
    "@eltjs/elt-sqlite": "^0.12.0",
    "@eltjs/embedding": "^0.12.0",
    "@zukhruf/sqlite-drift": "^0.8.105",
    "@zukhruf/sqlite-transaction": "^0.8.105",
    "ai": "^7.0.165"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.37",
    "@zukhruf/fs": "^0.8.105",
    "@zukhruf/retrieval": "^0.8.105",
    "@zukhruf/sqlite-open": "^0.8.105",
    "@zukhruf/testing": "^0.8.105",
    "@zukhruf/vectors": "^0.8.105",
    "gpt-tokenizer": "^4.1.2"
  }
}
