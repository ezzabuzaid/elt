{
  "name": "@eltjs/elt",
  "version": "0.2.0",
  "description": "A pipeline that copies the data of apps and services into stores that SQL can read: sources, streams, checkpoints, watches and derived datasets.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ezzabuzaid/elt",
    "directory": "packages/elt"
  },
  "bugs": {
    "url": "https://github.com/ezzabuzaid/elt/issues"
  },
  "homepage": "https://github.com/ezzabuzaid/elt/tree/main/packages/elt#readme",
  "keywords": [
    "elt",
    "etl",
    "pipeline",
    "data-pipeline",
    "change-data-capture",
    "sync"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@zukhruf/async": "^0.8.10",
    "@zukhruf/snapshot-differential": "^0.8.10"
  },
  "devDependencies": {
    "@zukhruf/testing": "^0.8.10"
  }
}
