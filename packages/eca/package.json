{
  "name": "@eltjs/eca",
  "version": "0.3.2",
  "description": "Event-condition-action rules over a warehouse that elt loads: a condition reads the warehouse at two positions, and the host saves each rule's cursor with what became true between them.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ezzabuzaid/elt",
    "directory": "packages/eca"
  },
  "bugs": {
    "url": "https://github.com/ezzabuzaid/elt/issues"
  },
  "homepage": "https://github.com/ezzabuzaid/elt/tree/main/packages/eca#readme",
  "keywords": [
    "elt",
    "eca",
    "event-condition-action",
    "rules",
    "alerts",
    "warehouse"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@eltjs/elt": "^0.3.2",
    "@eltjs/elt-sqlite": "^0.3.2",
    "@zukhruf/sqlite-open": "^0.8.10",
    "@zukhruf/testing": "^0.8.10"
  }
}
