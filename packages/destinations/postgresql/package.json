{
  "name": "@eltjs/elt-postgresql",
  "version": "0.7.0",
  "description": "The Postgres destination of elt: each stream is a typed table in _warehouse, with a reader view in marts that the host names, a history of each row for readings as of a position, and the views and computed datasets that a pipeline derives.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ezzabuzaid/elt",
    "directory": "packages/destinations/postgresql"
  },
  "bugs": {
    "url": "https://github.com/ezzabuzaid/elt/issues"
  },
  "homepage": "https://github.com/ezzabuzaid/elt/tree/main/packages/destinations/postgresql#readme",
  "keywords": [
    "elt",
    "postgres",
    "postgresql",
    "destination",
    "pipeline"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@eltjs/elt": "^0.7.0",
    "@zukhruf/async": "^0.8.31",
    "@zukhruf/vectors": "^0.8.40",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@zukhruf/fs": "^0.8.31",
    "@zukhruf/snapshot-differential": "^0.8.31",
    "@zukhruf/testing": "^0.8.31"
  }
}
