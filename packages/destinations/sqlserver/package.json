{
  "name": "@eltjs/elt-sqlserver",
  "version": "0.9.3",
  "description": "The SQL Server destination of elt: each stream is a typed table in _warehouse, with a reader view in marts that the host names, numbered commits that readers read as of a position, and a checkpoint store and a sync history in the same database.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ezzabuzaid/elt",
    "directory": "packages/destinations/sqlserver"
  },
  "bugs": {
    "url": "https://github.com/ezzabuzaid/elt/issues"
  },
  "homepage": "https://github.com/ezzabuzaid/elt/tree/main/packages/destinations/sqlserver#readme",
  "keywords": [
    "elt",
    "sql-server",
    "azure-sql",
    "mssql",
    "destination",
    "pipeline"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/spec/**",
    "!**/*.tsbuildinfo",
    "!**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@eltjs/elt": "^0.9.3",
    "@eltjs/sdk-microsoft-sql-server": "^0.9.3",
    "@zukhruf/async": "^0.8.51",
    "@zukhruf/mutex": "^0.8.31",
    "@zukhruf/vectors": "^0.8.51"
  },
  "devDependencies": {
    "@zukhruf/testing": "^0.8.31"
  }
}
