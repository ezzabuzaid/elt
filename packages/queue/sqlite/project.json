{
  "name": "queue-sqlite",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/queue/sqlite/src",
  "projectType": "library",
  "tags": ["scope:app", "layer:island"],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "main": "{projectRoot}/src/index.ts",
        "tsConfig": "{projectRoot}/tsconfig.lib.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --test --no-warnings --test-force-exit --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-results.xml",
        "cwd": "{projectRoot}"
      }
    },
    "format": {
      "command": "prettier --write {projectRoot}"
    }
  }
}
