{
  "uid": "elt-crawl",
  "title": "elt crawl",
  "tags": ["elt"],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 41,
  "editable": true,
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(elt_crawl_requests_total, service_name)",
          "refId": "service"
        },
        "definition": "label_values(elt_crawl_requests_total, service_name)",
        "refresh": 2,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests/s by origin",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 10,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (elt_origin) (rate(elt_crawl_requests_total{service_name=\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{elt_origin}}",
          "interval": "5s"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Outcomes",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 10,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 30,
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (class) (label_replace(rate(elt_crawl_requests_total{service_name=\"$service\", http_response_status_code!=\"\"}[$__rate_interval]), \"class\", \"${1}xx\", \"http_response_status_code\", \"([0-9]).*\"))",
          "legendFormat": "{{class}}",
          "interval": "5s"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (error_type) (rate(elt_crawl_requests_total{service_name=\"$service\", http_response_status_code=\"\"}[$__rate_interval]))",
          "legendFormat": "{{error_type}}",
          "interval": "5s"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Blocks",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(elt_origin_blocks_total{service_name=\"$service\"}[$__range]))",
          "interval": "5s"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Where the time goes",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 30,
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(elt_crawl_request_wait_seconds_sum{service_name=\"$service\"}[$__rate_interval]))",
          "legendFormat": "wait for the origin",
          "interval": "5s"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(elt_crawl_request_duration_seconds_sum{service_name=\"$service\"}[$__rate_interval]))",
          "legendFormat": "http",
          "interval": "5s"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(elt_crawl_handoff_duration_seconds_sum{service_name=\"$service\"}[$__rate_interval])) - sum(rate(elt_web_extract_duration_seconds_sum{service_name=\"$service\"}[$__rate_interval]))",
          "legendFormat": "consumer",
          "interval": "5s"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(elt_web_extract_duration_seconds_sum{service_name=\"$service\"}[$__rate_interval]))",
          "legendFormat": "extract",
          "interval": "5s"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request time p50/p95 by origin",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 10,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, elt_origin) (rate(elt_crawl_request_duration_seconds_bucket{service_name=\"$service\"}[$__rate_interval])))",
          "legendFormat": "p50 {{elt_origin}}",
          "interval": "5s"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, elt_origin) (rate(elt_crawl_request_duration_seconds_bucket{service_name=\"$service\"}[$__rate_interval])))",
          "legendFormat": "p95 {{elt_origin}}",
          "interval": "5s"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Frontier pending by lane",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 10,
        "y": 16,
        "w": 10,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 30,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (elt_crawl_lane) (elt_crawl_frontier_pending{service_name=\"$service\"})",
          "legendFormat": "{{elt_crawl_lane}}",
          "interval": "5s"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Held",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 16,
        "w": 4,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(elt_crawl_frontier_held{service_name=\"$service\"})",
          "interval": "5s"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Records committed by stream",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 10,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (elt_connection, elt_stream) (increase(elt_copy_records_committed_total{service_name=\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{elt_connection}} {{elt_stream}}",
          "interval": "5s"
        }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Recent crawls",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 10,
        "y": 24,
        "w": 14,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"$service\" && name=\"elt.crawl\"}",
          "tableType": "traces",
          "limit": 20
        }
      ]
    },
    {
      "id": 10,
      "type": "logs",
      "title": "Warnings and errors",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 10
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"$service\"} | severity_text=~\"WARN|ERROR\""
        }
      ]
    }
  ]
}
