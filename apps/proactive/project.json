{
  "name": "proactive",
  "sourceRoot": "apps/proactive/src",
  "projectType": "application",
  "targets": {
    "format": {},
    "test": {
      "dependsOn": ["build"],
      "command": "node --test --test-global-setup=apps/proactive/dist/docker-global-setup.js {args} apps/proactive/dist/*.test.js"
    },
    "start": {
      "dependsOn": ["build"],
      "command": "node apps/proactive/dist/main.js"
    }
  }
}
