{
  "name": "apple-plugin",
  "sourceRoot": "apps/apple/plugin/src",
  "projectType": "application",
  "targets": {
    "format": {},
    "bundle": {
      "command": "node apps/apple/plugin/build.mjs",
      "options": { "outdir": "dist/apps/apple/plugin/server" },
      "configurations": {
        "release": { "outdir": "plugins/apple/server" }
      },
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["default", "^default"],
      "outputs": ["{options.outdir}"]
    },
    "test": {
      "dependsOn": ["build", "bundle"],
      "command": "node --test \"apps/apple/plugin/dist/*.test.js\""
    }
  }
}
