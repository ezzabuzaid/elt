{
  "name": "apple-plugin",
  "sourceRoot": "apps/apple/plugin/src",
  "projectType": "application",
  "targets": {
    "format": {},
    "bundle": {
      "command": "node apps/apple/plugin/build.mjs",
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["default", "^default"],
      "outputs": ["{workspaceRoot}/plugins/apple/server"]
    },
    "test": {
      "dependsOn": ["build", "bundle"],
      "command": "node --test \"apps/apple/plugin/dist/*.test.js\""
    }
  }
}
