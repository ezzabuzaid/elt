{
  "name": "apple",
  "sourceRoot": "apps/apple/src",
  "projectType": "application",
  "targets": {
    "lint": {},
    "plugin": {
      "executor": "@nx/esbuild:esbuild",
      "dependsOn": ["^build"],
      "outputs": ["{workspaceRoot}/plugins/apple/server.mjs"],
      "options": {
        "main": "apps/apple/src/plugin/main.ts",
        "tsConfig": "apps/apple/tsconfig.json",
        "outputPath": "plugins/apple",
        "outputFileName": "server.mjs",
        "deleteOutputPath": false,
        "format": ["esm"],
        "platform": "node",
        "target": "node24.19",
        "thirdParty": true,
        "declaration": false,
        "skipTypeCheck": true,
        "esbuildOptions": {
          "logLevel": "warning",
          "outExtension": {
            ".js": ".mjs"
          },
          "banner": {
            "js": "import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);"
          }
        }
      }
    },
    "start": {
      "dependsOn": ["build"],
      "command": "node apps/apple/dist/main.js"
    },
    "test": {
      "dependsOn": ["build", "plugin"],
      "command": "node --test \"apps/apple/dist/*.test.js\""
    }
  }
}
