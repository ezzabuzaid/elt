{
  "name": "apple",
  "sourceRoot": "apps/apple/src",
  "projectType": "application",
  "targets": {
    "lint": {},
    "eventkit": {
      "command": "sh apps/apple/src/platform/macos/eventkit/build.sh apps/apple/dist/platform/macos/eventkit",
      "cache": true,
      "inputs": ["{projectRoot}/src/platform/macos/eventkit/*"],
      "outputs": ["{projectRoot}/dist/platform/macos/eventkit"]
    },
    "build": {
      "dependsOn": ["...", "eventkit"]
    },
    "plugin": {
      "executor": "@nx/esbuild:esbuild",
      "dependsOn": ["^build", "eventkit"],
      "outputs": [
        "{workspaceRoot}/plugins/apple/server.mjs",
        "{workspaceRoot}/plugins/apple/eventkit"
      ],
      "options": {
        "main": "apps/apple/src/plugin/main.ts",
        "tsConfig": "apps/apple/tsconfig.json",
        "outputPath": "plugins/apple",
        "outputFileName": "server.mjs",
        "deleteOutputPath": false,
        "format": ["esm"],
        "platform": "node",
        "target": "node24.19",
        "thirdParty": true,
        "declaration": false,
        "skipTypeCheck": true,
        "assets": [
          {
            "input": "apps/apple/dist/platform/macos",
            "glob": "eventkit",
            "output": "."
          }
        ],
        "includeIgnoredAssetFiles": true,
        "esbuildOptions": {
          "logLevel": "warning",
          "outExtension": { ".js": ".mjs" },
          "banner": {
            "js": "import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);"
          }
        }
      }
    },
    "start": {
      "dependsOn": ["build"],
      "command": "node apps/apple/dist/main.js"
    },
    "test": {
      "dependsOn": ["build", "plugin"],
      "command": "node --test \"apps/apple/dist/*.test.js\""
    }
  }
}
