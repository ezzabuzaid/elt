{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": false,
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        },
        "build": {
          "targetName": "build",
          "configName": "tsconfig.lib.json"
        }
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    "@zukhruf/nx/lint",
    "@zukhruf/nx/test"
  ],
  "targetDefaults": {
    "format": {
      "command": "prettier --write {projectRoot}"
    },
    "typecheck": {
      "dependsOn": ["format", "lint", "..."]
    },
    "test": {
      "dependsOn": ["...", "build"]
    }
  },
  "sync": {
    "applyChanges": true
  }
}
