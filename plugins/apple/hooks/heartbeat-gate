#!/bin/sh
# Codex runs this UserPromptSubmit hook before every prompt in every chat, so
# only a heartbeat whose instructions name a gated skill ($meeting-prep or
# $garden-apple) starts Node, which decides whether the heartbeat reaches the
# model.
set -eu

input=$(cat)
case "$input" in
  *'<heartbeat>'*'$meeting-prep'* | *'<heartbeat>'*'$garden-apple'*) ;;
  *) exit 0 ;;
esac

plugin=$(cd "$(dirname "$0")/.." && pwd)
printf '%s' "$input" | "$plugin/launch_node" "$plugin/server/heartbeat-hook.mjs"
