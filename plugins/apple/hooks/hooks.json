{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "apple",
            "tool": "apple_context",
            "input": { "event": "${hook_event_name}" },
            "statusMessage": "Reading Apple status"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "apple",
            "tool": "apple_context",
            "input": { "event": "${hook_event_name}" },
            "statusMessage": "Reading Apple status"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/heartbeat-gate\""
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "mcp__codex_app__create_thread|mcp__codex_app__send_message_to_thread",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/approval-gate\""
          }
        ]
      }
    ]
  }
}
