#!/bin/sh
# Codex runs this UserPromptSubmit hook before every prompt in every chat, so
# only a heartbeat whose instructions name $meeting-prep starts Node, which
# decides whether the heartbeat reaches the model.
set -eu

input=$(cat)
case "$input" in
  *'<heartbeat>'*'$meeting-prep'*) ;;
  *) exit 0 ;;
esac

plugin=$(cd "$(dirname "$0")/.." && pwd)
printf '%s' "$input" | "$plugin/launch_node" "$plugin/server/meeting-prep-gate.mjs"
